# Cloudflare Pages — headers de caché y seguridad
# https://developers.cloudflare.com/pages/configuration/headers/

# Seguridad de base para todo el sitio
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()

# HTML: siempre revalidar para que las actualizaciones se vean al instante
/*.html
  Cache-Control: public, max-age=0, must-revalidate

# CSS y JS: siempre revalidar; sin hashes en el nombre, una caché larga mezcla HTML nuevo con estilos viejos
/css/*
  Cache-Control: public, max-age=0, must-revalidate
/js/*
  Cache-Control: public, max-age=0, must-revalidate

# Imágenes y favicons: cambian poco, caché larga
/assets/img/*
  Cache-Control: public, max-age=31536000, immutable
/assets/favicon/*
  Cache-Control: public, max-age=31536000, immutable
/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable
