# Cloudflare Pages — headers de caché y seguridad
# https://developers.cloudflare.com/pages/configuration/headers/

# Seguridad de base para todo el sitio
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()

# HTML: siempre revalidar para que las actualizaciones se vean al instante
/*.html
  Cache-Control: public, max-age=0, must-revalidate

# CSS y JS: caché corta (no usamos hashes de versión en el nombre de archivo)
/css/*
  Cache-Control: public, max-age=3600
/js/*
  Cache-Control: public, max-age=3600

# Imágenes y favicons: cambian poco, caché larga
/assets/img/*
  Cache-Control: public, max-age=31536000, immutable
/assets/favicon/*
  Cache-Control: public, max-age=31536000, immutable
